# Server-side Gemini API key (configured via Settings > Secrets or Vercel Env Vars)
GEMINI_API_KEY=

# Optional client-side Firebase config (used on Vercel / external deployments when firebase-applet-config.json is absent)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=
